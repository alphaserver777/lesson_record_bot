#!/usr/bin/env bash
set -Eeuo pipefail

runtime_root="{{ runtime_root }}"
backup_dir="${runtime_root}/backups/postgres"
postgres_env="${runtime_root}/secrets/postgres.env"
container="postgres-postgres-1"
retention_days="14"

install -d -m 0700 -o root -g root "${backup_dir}"
set -a
# shellcheck disable=SC1090
source "${postgres_env}"
set +a

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
temporary="${backup_dir}/.${POSTGRES_DB}-${timestamp}.dump.partial"
destination="${backup_dir}/${POSTGRES_DB}-${timestamp}.dump"

cleanup() {
  rm -f "${temporary}"
}
trap cleanup EXIT

docker exec "${container}" pg_dump \
  --username "${POSTGRES_USER}" \
  --dbname "${POSTGRES_DB}" \
  --format custom \
  --compress 6 > "${temporary}"

test -s "${temporary}"
docker exec -i "${container}" pg_restore --list < "${temporary}" >/dev/null
chmod 0600 "${temporary}"
mv "${temporary}" "${destination}"
sha256sum "${destination}" > "${destination}.sha256"
chmod 0600 "${destination}.sha256"

find "${backup_dir}" -type f \
  \( -name '*.dump' -o -name '*.dump.sha256' \) \
  -mtime "+${retention_days}" -delete
